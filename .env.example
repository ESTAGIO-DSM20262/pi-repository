# Neon Postgres connection string.
# Copy this file to `.env` and fill in the real values.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth
# Gere um valor com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL base da aplicação (usada pelo better-auth para cookies e callbacks).
BETTER_AUTH_URL="http://localhost:3000"

# Microsoft Entra ID (login institucional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Opcional. Escopo multi-tenant do provedor. Padrão: "organizations"
# (qualquer tenant corporativo/escolar; contas pessoais ficam de fora).
# Para restringir a um tenant específico, informe o Tenant ID ou o domínio.
MICROSOFT_TENANT_ID=""
