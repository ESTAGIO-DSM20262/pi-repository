# Neon Postgres connection string.
# Copy this file to `.env` and fill in the real values.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# better-auth
# Gere um valor com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL base da aplicação (usada pelo better-auth para cookies e callbacks).
BETTER_AUTH_URL="http://localhost:3000"

# Microsoft Entra ID (login institucional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Escopo do provedor. Vazio equivale a "organizations" (qualquer tenant
# corporativo/escolar; contas pessoais ficam de fora).
# Em produção, informe o Tenant ID da Fatec para aceitar só esse tenant.
# O login só funciona para e-mails já cadastrados no sistema.
MICROSOFT_TENANT_ID=""

# Resend (e-mail de redefinição de senha)
# Sem estas variáveis, fora de produção, o link é impresso no console do servidor.
RESEND_API_KEY=""
# Remetente de um domínio verificado no Resend.
EMAIL_FROM="Acervo Acadêmico <no-reply@seu-dominio>"
