{
  "name": "acervo-academico-fatec",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "prepare": "husky",
    "email:dev": "email dev --dir src/infrastructure/email/templates --port 3001",
    "db:migrate:repair": "drizzle-kit migrate --config=drizzle-repair.config.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.2.0",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^1.0.0-rc.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "resend": "^6.34.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@react-email/ui": "^6.11.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "react-email": "^6.11.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@typeschema/zod": {
      "zod": "^4.0.0"
    }
  }
}
